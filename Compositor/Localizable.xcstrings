      }
    },
    "Paste": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴"
          }
        }
      }
    },
    "Perspective allows stronger keystone. Rectilinear keeps the warp gentler.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "透视可实现更强的梯形校正，直线投影则让变形更轻微。"
          }
        }
      }
    },
    "Pixel Grid (800% and above)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像素网格 (800% 及以上)"
