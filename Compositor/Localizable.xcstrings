        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平移"
          }
        }
      }
    },
    "Parametric lifts tonal regions. Point places anchors on the curve.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参数可提升色调区域。点可在曲线上放置锚点。"
