        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置"
          }
        }
      }
    },
    "Positive straightens lines that bow outward (barrel); negative, lines that bow inward (pincushion).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正值校正向外弯曲的线条（桶形）；负值校正向内弯曲的线条（枕形）。"
          }
        }
      }
    },
    "Positive values tighten the detected mask inward; negative values expand it outward": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正值使检测到的蒙版向内收紧；负值使其向外扩展"
          }
        }
      }
    },
    "Preserve Luminosity": {
