    "Use 1–%@ pixels per side, up to %lld megapixels, and 1–9,600 pixels/inch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Use 1–%1$@ pixels per side, up to %2$lld megapixels, and 1–9,600 pixels/inch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每边使用 1–%@ 像素，最多 %lld 百万像素，以及 1–9,600 像素/英寸。"
          }
        }
      }
    },
    "Use gridlines every %lld–%@ pixels and %lld–%lld subdivisions, no more than the pixels between gridlines.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Use gridlines every %1$lld–%2$@ pixels and %3$lld–%4$lld subdivisions, no more than the pixels between gridlines."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网格线间距使用 %lld–%@ 像素，细分使用 %lld–%lld，且不超过网格线之间的像素数。"
          }
        }
      }
